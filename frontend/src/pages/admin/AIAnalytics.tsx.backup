import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { API_BASE_URL } from '../../config/api';

interface AIInsights {
  hot_selling_items: any[];
  underperforming_items: any[];
  sales_forecast: any;
  category_performance: any[];
  summary: any;
}

const AIAnalytics: React.FC = () => {
  const [insights, setInsights] = useState<AIInsights | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    fetchInsights();
  }, []);

  const fetchInsights = async () => {
    try:
      setLoading(true);
      const token = localStorage.getItem('token');
      const response = await axios.get(`${API_BASE_URL}/api/ai/insights`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      setInsights(response.data);
      setError(null);
    } catch (err: any) {
      setError(err.response?.data?.detail || 'Failed to fetch AI insights');
    } finally {
      setLoading(false);
    }
  };

  if (loading) {
    return (
      <div className="flex justify-center items-center h-64">
        <div className="text-xl">🤖 AI is analyzing your data...</div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-red-50 border border-red-200 rounded-lg p-4 m-4">
        <p className="text-red-800">{error}</p>
        <button onClick={fetchInsights} className="mt-2 bg-red-600 text-white px-4 py-2 rounded">
          Retry
        </button>
      </div>
    );
  }

  if (!insights) return null;

  return (
    <div className="p-6 space-y-6">
      {/* Header */}
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-3xl font-bold">🤖 AI Analytics</h1>
          <p className="text-gray-600 mt-1">AI-powered insights for your restaurant</p>
        </div>
        <button onClick={fetchInsights} className="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
          🔄 Refresh
        </button>
      </div>

      {/* Summary Cards */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className="bg-gradient-to-br from-green-50 to-green-100 rounded-lg p-6 border border-green-200">
          <h3 className="text-lg font-semibold text-green-800">Items Analyzed</h3>
          <p className="text-3xl font-bold text-green-600 mt-2">{insights.summary.total_items_analyzed}</p>
        </div>
        <div className="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-6 border border-blue-200">
          <h3 className="text-lg font-semibold text-blue-800">Top Seller</h3>
          <p className="text-lg font-bold text-blue-600 mt-2">{insights.summary.top_revenue_item || 'N/A'}</p>
        </div>
        <div className="bg-gradient-to-br from-orange-50 to-orange-100 rounded-lg p-6 border border-orange-200">
          <h3 className="text-lg font-semibold text-orange-800">Need Attention</h3>
          <p className="text-3xl font-bold text-orange-600 mt-2">{insights.summary.items_needing_attention}</p>
        </div>
      </div>

      {/* Hot Selling Items */}
      <div className="bg-white rounded-lg shadow-lg p-6">
        <h2 className="text-2xl font-bold mb-4 flex items-center gap-2">
          🔥 Hot Selling Items
        </h2>
        <div className="space-y-4">
          {insights.hot_selling_items.map((item, index) => (
            <div key={item.menu_item_id} className="bg-gradient-to-r from-red-50 to-orange-50 border border-orange-200 rounded-lg p-4">
              <div className="flex justify-between items-start">
                <div className="flex-1">
                  <div className="flex items-center gap-3">
                    <span className="text-2xl font-bold text-orange-600">#{index + 1}</span>
                    <div>
                      <h3 className="text-lg font-bold text-gray-900">{item.name}</h3>
                      <p className="text-sm text-gray-600 mt-1">{item.recommendation}</p>
                    </div>
                  </div>
                  <div className="grid grid-cols-3 gap-4 mt-3">
                    <div>
                      <p className="text-xs text-gray-600">Total Sold</p>
                      <p className="text-lg font-bold text-gray-900">{item.total_quantity}</p>
                    </div>
                    <div>
                      <p className="text-xs text-gray-600">Orders</p>
                      <p className="text-lg font-bold text-gray-900">{item.order_count}</p>
                    </div>
                    <div>
                      <p className="text-xs text-gray-600">Revenue</p>
                      <p className="text-lg font-bold text-green-600">Rs. {item.total_revenue.toFixed(2)}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Underperforming Items */}
      <div className="bg-white rounded-lg shadow-lg p-6">
        <h2 className="text-2xl font-bold mb-4 flex items-center gap-2">
          ⚠️ Items Needing Attention
        </h2>
        <div className="space-y-4">
          {insights.underperforming_items.map((item) => (
            <div key={item.menu_item_id} className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
              <div className="flex justify-between items-start">
                <div className="flex-1">
                  <h3 className="text-lg font-bold text-gray-900">{item.name}</h3>
                  <p className="text-sm text-yellow-700 mt-1 font-medium">{item.recommendation}</p>
                  <div className="grid grid-cols-3 gap-4 mt-3">
                    <div>
                      <p className="text-xs text-gray-600">Total Sold</p>
                      <p className="text-lg font-bold text-gray-900">{item.total_quantity}</p>
                    </div>
                    <div>
                      <p className="text-xs text-gray-600">Orders</p>
                      <p className="text-lg font-bold text-gray-900">{item.order_count}</p>
                    </div>
                    <div>
                      <p className="text-xs text-gray-600">Revenue</p>
                      <p className="text-lg font-bold text-red-600">Rs. {item.total_revenue.toFixed(2)}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Category Performance */}
      <div className="bg-white rounded-lg shadow-lg p-6">
        <h2 className="text-2xl font-bold mb-4">📊 Category Performance</h2>
        <div className="space-y-3">
          {insights.category_performance.map((cat) => (
            <div key={cat.category_id} className="flex items-center gap-4 p-3 bg-gray-50 rounded-lg">
              <div className="flex-1">
                <p className="font-semibold">Category #{cat.category_id}</p>
                <div className="w-full bg-gray-200 rounded-full h-2 mt-2">
                  <div 
                    className="bg-blue-600 h-2 rounded-full"
                    style={{ width: `${cat.revenue_percentage}%` }}
                  ></div>
                </div>
              </div>
              <div className="text-right">
                <p className="text-sm text-gray-600">{cat.revenue_percentage}%</p>
                <p className="font-bold text-green-600">Rs. {cat.total_revenue.toFixed(2)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Sales Forecast */}
      {insights.sales_forecast.forecast && (
        <div className="bg-white rounded-lg shadow-lg p-6">
          <h2 className="text-2xl font-bold mb-4">📈 7-Day Sales Forecast</h2>
          <div className="grid grid-cols-1 md:grid-cols-7 gap-3">
            {insights.sales_forecast.forecast.map((day: any) => (
              <div key={day.date} className="bg-blue-50 border border-blue-200 rounded-lg p-3 text-center">
                <p className="text-xs text-gray-600">{new Date(day.date).toLocaleDateString('en-US', { weekday: 'short' })}</p>
                <p className="text-xs text-gray-500">{new Date(day.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</p>
                <p className="text-lg font-bold text-blue-600 mt-2">Rs. {day.predicted_revenue}</p>
                <p className="text-xs text-gray-600">{day.predicted_orders} orders</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
};

export default AIAnalytics;
